# Public URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://africaweb3.academy

# Form delivery (https://resend.com) — server-side only, never exposed to the browser.
# Optional if SUBMISSIONS_STORE is on; with no channel at all, forms show an explicit "not configured" error.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Site AWA <site@africaweb3.academy>"
FORMS_FROM_EMAIL=
# Recipient(s), comma-separated
FORMS_TO_EMAIL=africaweb3academy@gmail.com

# Store submissions for the admin app (JSON lines). Set to off on read-only hosts (e.g. Vercel).
SUBMISSIONS_STORE=on
# Optional custom path (default: ./data/submissions.jsonl)
# SUBMISSIONS_FILE=
